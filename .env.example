# ============================================================
#  SACHIN DEV X FX — example settings (ALL VALUES ARE DUMMY)
#  Copy this file to .env and fill in your own values.
#  Keep PROVIDER_MODE=mock + PAYMENT_MODE=mock until you have
#  real provider/payment accounts and have tested everything.
# ============================================================
BOT_TOKEN=123456789:AAHdummyTokenReplaceMe_xxxxxxxxxxxxxxxxx
DATABASE_URL=sqlite+aiosqlite:///./glory.db
ADMIN_IDS=123456789
SUPER_ADMIN_IDS=123456789
BUSINESS_TIMEZONE=Asia/Kathmandu
DEFAULT_CURRENCY=NPR
DEFAULT_PRICE_PER_SQUAD=375
MAX_SQUADS_PER_ORDER=10

# ---- Glory provider (dummy) ----
PROVIDER_MODE=mock
GLORY_API_ENABLED=false
GLORY_API_BASE_URL=https://glory-api.example.com
GLORY_API_KEY=
GLORY_API_MASTER_KEY=
GLORY_API_TIMEOUT=20

# ---- Payments (dummy QR gateway) ----
PAYMENT_MODE=mock
APINEPAL_BASE_URL=https://payments.example.com
APINEPAL_SECRET_KEY=
APINEPAL_PUBLIC_KEY=
APINEPAL_QR_PROVIDER=fonebiz
PAYMENT_UI_MINUTES=15
PAYMENT_INSTRUCTIONS=Dummy mode — no real payment is taken.

# ---- Contact / branding (dummy) ----
SUPPORT_USERNAME=example_support
WEBSITE_URL=shop.example.com
LOG_LEVEL=INFO

# ---- Buttons ----
BUTTON_COLORS=true
PREMIUM_EMOJI_BUTTONS=false
PREMIUM_EMOJI_IDS=
SERVICE_WINDOW=true

# ---- Web shop (runs inside the bot process) ----
WEB_ENABLED=true
# WEB_PORT=          # leave empty: uses the panel port (SERVER_PORT)
PUBLIC_URL=          # your shop address, e.g. https://shop.example.com (shown in /weblogin)
